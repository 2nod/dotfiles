#!/usr/bin/env bash
set -euo pipefail

remote_name="${1:-}"
remote_url="${2:-}"

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
allowlist_file="${HOOK_ALLOWLIST_FILE:-$script_dir/pre-push.allowlist}"

# 限定公開 site の配布元 repository は main が公開元そのものなので、feature
# branch と PR を挟む前提が成り立たない。目印は .openai/hosting.json の存在。
# remote URL の allowlist と違い、site repository が増えても登録作業が要らない。
is_site_source_repo() {
  local repo_root

  repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
  [[ -f "$repo_root/.openai/hosting.json" ]]
}

is_allowlisted_remote() {
  local allowed_remote_url

  if [[ ! -f "$allowlist_file" ]]; then
    return 1
  fi

  while IFS= read -r allowed_remote_url; do
    [[ -n "$allowed_remote_url" ]] || continue
    [[ "${allowed_remote_url#\#}" != "$allowed_remote_url" ]] && continue

    if [[ "$remote_url" == "$allowed_remote_url" ]]; then
      return 0
    fi
  done < "$allowlist_file"

  return 1
}

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      if is_allowlisted_remote; then
        continue
      fi

      # 例外を通したことは黙らせない。site repository への直接 push は
      # 公開操作なので、起きたことが見えている必要がある。
      if is_site_source_repo; then
        echo "pre-push: allowing $remote_ref: this is a site source repository (.openai/hosting.json)." >&2
        continue
      fi

      echo "pre-push: refusing direct push to protected branch: $remote_ref" >&2
      echo "pre-push: push to a feature branch and open a PR instead." >&2
      echo "pre-push: add the remote URL to $allowlist_file to allow it." >&2
      exit 1
      ;;
  esac
done

exit 0
